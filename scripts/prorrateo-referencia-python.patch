+def _prorratear_por_ingreso(
+    liq: LiquidacionSocio, propias: list[Anestesia], desde: date, usuario: str,
+) -> list[Anestesia]:
+    """Recorta un socio nuevo a lo que le corresponde desde su ingreso al grupo.
+
+    JBO y RRISO entraron el 1/9/2026 y su liquidación incluye anestesias
+    anteriores (trabajo previo, no es del grupo). evweb calcula las deducciones
+    sobre el total facturado, así que quedarse con las anestesias posteriores y
+    las deducciones enteras le restaría de más.
+
+    Se prorratea por MONTO, no por cantidad de anestesias:
+
+        proporción = Σ importe (fecha >= ingreso) / Σ importe (todas)
+
+    y se aplica a crédito, deducciones y total cobrado. Ejemplo del usuario
+    (2026-10-30): 100 facturado, 50 posterior al 1/9 → proporción 50%;
+    deducciones de 50 → se toman 25.
+
+    Devuelve sólo las anestesias desde el ingreso; muta `liq` con los importes
+    prorrateados.
+    """
+    total = sum(a.monto for a in propias)
+    posteriores = [a for a in propias if a.fecha >= desde]
+    monto_post = sum(a.monto for a in posteriores)
+
+    if total <= 0:
+        return posteriores
+
+    prop = monto_post / total
+    credito_orig = liq.credito
+    ded_orig = liq.total_deducciones
+    cobrado_orig = liq.total_cobrado
+
+    liq.credito = round(credito_orig * prop, 2)
+    liq.total_deducciones = round(ded_orig * prop, 2)
+    liq.total_cobrado = round(cobrado_orig * prop, 2)
+    # las líneas de deducción también, para que la hoja de personales no muestre
+    # el importe entero de un socio que entró a mitad de período
+    liq.deducciones = [
+        DeduccionLinea(concepto=d.concepto, monto=round(d.monto * prop, 2))
+        for d in liq.deducciones
+    ]
+
+    print(
+        f"    {usuario}: ingresó {desde}; "
+        f"{len(posteriores)}/{len(propias)} anestesias desde el ingreso, "
+        f"{monto_post:,.2f} de {total:,.2f} = {prop:.4%}. "
+        f"Cobrado {cobrado_orig:,.2f} -> {liq.total_cobrado:,.2f}, "
+        f"deducciones {ded_orig:,.2f} -> {liq.total_deducciones:,.2f}"
+    )
+    return posteriores
+
+
